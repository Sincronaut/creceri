{
  "version": 3,
  "$schema": "https://schemas.wp.org/wp/6.8/theme.json",

  "templateParts": [
    { "name": "header-custom", "title": "Header (Custom)", "area": "header" },
    { "name": "footer-custom", "title": "Footer (Custom)", "area": "footer" }
  ],

  "settings": {
    "layout": {
      "contentSize": "",
      "wideSize": "",
      "defaultLayout": false
    },
    "spacing": {
      "padding": false,
      "blockGap": false
    },
    "typography": {
      "fluid": false,
      "fontSizes": [
        {
          "slug": "body",
          "name": "Body",
          "size": "20px"
        },
        {
          "slug": "h-4",
          "name": "H4",
          "size": "24px"
        },
        {
          "slug": "h-3",
          "name": "H3",
          "size": "32px"
        },
        {
          "slug": "h-2",
          "name": "H2",
          "size": "45px"
        },
        {
          "slug": "h-1",
          "name": "H1",
          "size": "64px"
        }
      ]
    }
  },

  "styles": {
    "layout": {
      "contentSize": "100%",
      "wideSize": "100%"
    },
    "typography": {
      "fontSize": "var(--wp--preset--font-size--body)",
      "lineHeight": "1.6"
    },
    "elements": {
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--h-1)", "fontWeight": "800", "lineHeight": "1.2" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--h-2)", "fontWeight": "700", "lineHeight": "1.3" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--h-3)", "fontWeight": "600", "lineHeight": "1.35" } },
      "h4": { "typography": { "fontSize": "var(--wp--preset--font-size--h-4)", "fontWeight": "600", "lineHeight": "1.35" } }
    },
    "blocks": {
      "core/paragraph": {
        "typography": { "fontSize": "var(--wp--preset--font-size--body)" }
      }
    }
  },

  "customTemplates": [
  { "name": "home", "title": "Custom Home Page", "postTypes": ["page"] },
  { "name": "page-ui", "title": "UI / Digital Marketing Page", "postTypes": ["page"] }
]
}
