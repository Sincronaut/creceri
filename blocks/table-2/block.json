{
  "apiVersion": 3,
  "name": "child/table-2",
  "title": "E-commerce Models Table",
  "category": "widgets",
  "description": "Responsive comparison table with optional intro and customizable rows.",
  "icon": "screenoptions",
  "supports": {
    "html": false,
    "anchor": true,
    "inserter": true,
    "align": ["wide", "full"]
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": "Choose the Right E-Commerce Model for Your Online Business"
    },
    "intro": { "type": "string", "default": "" },
    "ariaLabel": { "type": "string", "default": "E-commerce models" },
    "sectionId": { "type": "string", "default": "" },
    "columns": {
      "type": "array",
      "default": [
        { "key": "model", "label": "Model" },
        { "key": "description", "label": "Description" },
        { "key": "industries", "label": "Common Industries" }
      ],
      "items": {
        "type": "object",
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string" }
        }
      }
    },
    "rows": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "cells": {
            "type": "array",
            "default": [],
            "items": {
              "type": "object",
              "properties": {
                "text": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "boxSize": {
      "type": "string",
      "enum": ["wide", "short"],
      "default": "wide"
    },
    "background": {
      "type": "string",
      "enum": ["on", "off"],
      "default": "on"
    }
  },
  "render": "file:./render.php",
  "style": "file:./style.css"
}
