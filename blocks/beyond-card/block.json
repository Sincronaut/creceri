{
  "apiVersion": 3,
  "name": "child/beyond-card",
  "title": "Beyond Card",
  "category": "widgets",
  "description": "Two-column feature card with hero image and rich description.",
  "icon": "screenoptions",
  "supports": {
    "html": false,
    "anchor": true,
    "inserter": true,
    "align": ["wide", "full"]
  },
  "attributes": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "properties": {
        "src": { "type": "string" },
        "alt": { "type": "string" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "loading": { "type": "string", "enum": ["lazy", "eager"] },
        "decoding": { "type": "string", "enum": ["async", "sync", "auto"] }
      }
    }
  },
  "render": "file:./render.php",
  "style": "file:./style.css"
}
